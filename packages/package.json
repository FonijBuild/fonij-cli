{
  "name": "@fonijbuild/cli",
  "version": "1.0.0",
  "description": "The AI-first product builder CLI powered by the Fonij architecture catalog.",
  "type": "module",
  "bin": {
    "fonij": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm run check && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "cli",
    "ai",
    "product-builder",
    "architecture",
    "scaffolding",
    "code-generation",
    "developer-tools",
    "fonij"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "publishConfig": {
    "access": "public"
  }
}
